receivers:
  hostmetrics:
    collection_interval: 30s
    scrapers:
      cpu:
        metrics:
          system.cpu.utilization:
            enabled: true
      load: {}
      memory:
        metrics:
          system.memory.utilization:
            enabled: true
      disk: {}
      filesystem:
        metrics:
          system.filesystem.utilization:
            enabled: true
      network: {}
      paging: {}
{{DOCKER_RECEIVERS}}

processors:
  memory_limiter:
    check_interval: 5s
    limit_mib: 256
    spike_limit_mib: 64
  batch:
    send_batch_size: 512
    timeout: 10s
  resourcedetection/system:
    detectors: [system]
    system:
      hostname_sources: [os]
  resource/orvo:
    attributes:
      - key: host.id
        value: ${env:ORVO_HOST_ID}
        action: upsert
      - key: host.name
        value: ${env:ORVO_HOST_NAME}
        action: upsert
      - key: service.name
        value: orvo-host-agent
        action: upsert
      - key: orvo.app.id
        value: {{APP_ID}}
        action: upsert

exporters:
  otlphttp/orvo:
    endpoint: {{OTLP_ENDPOINT}}
    headers:
      Authorization: Bearer {{PRIVATE_INGESTION_KEY}}

service:
  pipelines:
    metrics:
      receivers: [hostmetrics{{DOCKER_METRICS_PIPELINE_RECEIVER}}]
      processors: [memory_limiter, resourcedetection/system, resource/orvo, batch]
      exporters: [otlphttp/orvo]
