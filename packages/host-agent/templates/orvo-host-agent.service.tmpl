[Unit]
Description=Orvo host monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{INSTALLER_USER}}
Group={{INSTALLER_USER}}
EnvironmentFile={{CONFIG_ROOT}}/{{INSTALLER_SERVICE_NAME}}.env
ExecStart={{INSTALL_ROOT}}/{{BINARY_NAME}} --config {{CONFIG_ROOT}}/otelcol.yaml
Restart=always
RestartSec=5
StateDirectory={{INSTALLER_SERVICE_NAME}}
WorkingDirectory={{STATE_ROOT}}
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
