{
  "name": "@repo/components",
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/lib/utils.ts",
      "svelte": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./hooks": {
      "types": "./src/lib/hooks/index.ts",
      "svelte": "./src/lib/hooks/index.ts",
      "default": "./src/lib/hooks/index.ts"
    },
    "./styles.css": "./src/lib/styles.css",
    "./ui/button": {
      "types": "./src/lib/components/ui/button/index.ts",
      "svelte": "./src/lib/components/ui/button/index.ts",
      "default": "./src/lib/components/ui/button/index.ts"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "lint": "eslint .",
    "sync-exports": "node ./scripts/sync-exports.mjs",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "clsx": "^2.1.1",
    "phosphor-svelte": "^3.1.0",
    "shadcn-svelte": "^1.2.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24.12.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^17.4.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.7"
  }
}
