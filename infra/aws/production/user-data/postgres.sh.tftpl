#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

volume_id="${replace(data_volume_id, "-", "")}"
device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${volume_id}"

for _ in $(seq 1 120); do
  if [ -b "$${device}" ]; then
    break
  fi
  sleep 2
done

test -b "$${device}"

if ! blkid "$${device}" >/dev/null 2>&1; then
  mkfs.ext4 -L orvo-postgres "$${device}"
fi

mkdir -p /var/lib/postgresql
uuid=$(blkid -s UUID -o value "$${device}")
if ! grep -q "$${uuid}" /etc/fstab; then
  echo "UUID=$${uuid} /var/lib/postgresql ext4 defaults,nofail 0 2" >> /etc/fstab
fi
mount /var/lib/postgresql

apt-get update
apt-get install -y ca-certificates curl jq postgresql-16 unzip

curl --fail --silent --show-error \
  "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" \
  --output /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update
rm -rf /tmp/aws /tmp/awscliv2.zip

install -d -o postgres -g postgres -m 700 /var/lib/postgresql/16/main
chown -R postgres:postgres /var/lib/postgresql

postgres_config=/etc/postgresql/16/main/postgresql.conf
postgres_hba=/etc/postgresql/16/main/pg_hba.conf

sed -i "s/^#\?listen_addresses.*/listen_addresses = '*'/" "$${postgres_config}"
sed -i "s/^#\?password_encryption.*/password_encryption = 'scram-sha-256'/" "$${postgres_config}"

install -d -o postgres -g postgres -m 700 /etc/postgresql/16/main/tls
openssl req -new -x509 -days 825 -nodes -text \
  -out /etc/postgresql/16/main/tls/server.crt \
  -keyout /etc/postgresql/16/main/tls/server.key \
  -subj '/CN=orvo-prod-postgres'
chown postgres:postgres /etc/postgresql/16/main/tls/server.crt /etc/postgresql/16/main/tls/server.key
chmod 600 /etc/postgresql/16/main/tls/server.key
cat >> "$${postgres_config}" <<'POSTGRES_TLS'
ssl = on
ssl_cert_file = '/etc/postgresql/16/main/tls/server.crt'
ssl_key_file = '/etc/postgresql/16/main/tls/server.key'
POSTGRES_TLS

cat >> "$${postgres_hba}" <<'POSTGRES_HBA'
hostssl orvo orvo 172.31.0.0/16 scram-sha-256
POSTGRES_HBA

systemctl restart postgresql

sudo -u postgres psql -v ON_ERROR_STOP=1 <<'POSTGRES_SETUP'
DO $do$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'orvo') THEN
    CREATE ROLE orvo LOGIN PASSWORD '${postgres_password}';
  ELSE
    ALTER ROLE orvo WITH LOGIN PASSWORD '${postgres_password}';
  END IF;
END
$do$;
SELECT 'CREATE DATABASE orvo OWNER orvo'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'orvo')\gexec
POSTGRES_SETUP

install -d -o postgres -g postgres -m 700 /var/backups/orvo-postgres
cat > /usr/local/sbin/orvo-postgres-backup <<'BACKUP_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
backup="/var/backups/orvo-postgres/orvo-$${timestamp}.dump"

cleanup() {
  rm -f "$${backup}"
}
trap cleanup EXIT

started=$(date +%s)
sudo -u postgres pg_dump -Fc orvo > "$${backup}"
test -s "$${backup}"
aws s3 cp "$${backup}" "s3://${backup_bucket}/postgres/daily/orvo-$${timestamp}.dump" --region "${region}" --only-show-errors
size=$(stat -c %s "$${backup}")
duration=$(( $(date +%s) - started ))
logger -t orvo-backup "database=postgres status=succeeded duration_seconds=$${duration} size_bytes=$${size} object=postgres/daily/orvo-$${timestamp}.dump"
BACKUP_SCRIPT
chmod 750 /usr/local/sbin/orvo-postgres-backup

cat > /etc/systemd/system/orvo-postgres-backup.service <<'BACKUP_SERVICE'
[Unit]
Description=Back up Orvo PostgreSQL to S3
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/orvo-postgres-backup
BACKUP_SERVICE

cat > /etc/systemd/system/orvo-postgres-backup.timer <<'BACKUP_TIMER'
[Unit]
Description=Nightly Orvo PostgreSQL backup

[Timer]
OnCalendar=*-*-* 02:15:00 UTC
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
BACKUP_TIMER

systemctl daemon-reload
systemctl enable --now orvo-postgres-backup.timer
